<?php

function calculate($arr, $choice)
{
    switch ($choice)
    {
        case "SUM":
            return array_sum($arr);

        case "COUNT":
            return count($arr);

        case "MAXIMUM":
            return max($arr);

        case "MINIMUM":
            return min($arr);

        default:
            return "Invalid Choice";
    }
}

if (isset($_POST['result']))
{
    $numbers = $_POST['numbers'];
    $arr = explode(",", $numbers);

    $choice = $_POST['choice'];

    $ans = calculate($arr, $choice);
}
?>

