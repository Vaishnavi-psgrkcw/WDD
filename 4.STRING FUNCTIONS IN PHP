<?php
if (isset($_POST['result'])) {
    $str = $_POST['str'];
    $choice = $_POST['choice'];
    switch ($choice) {
        case "LENGTH":
            $ans = strlen($str);
            break;
       case "WORD COUNT":
            $ans = str_word_count($str);
            break;
        case "REVERSE":
            $ans = strrev($str);
            break;
        case "UPPERCASE":
            $ans = strtoupper($str);
            break;
        case "LOWERCASE":
            $ans = strtolower($str);
            break;
        default:
            $ans = "Invalid Choice";
    }
}
?>
